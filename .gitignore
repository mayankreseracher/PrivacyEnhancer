# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/

# PyInstaller build artifacts
build/
dist/
*.manifest
*.spec.bak

# Local application databases & user logs
*.db
*.db-journal
*.db-wal
*.log
data/*.db
data/*.db-journal
data/proton_auth.json

# User WireGuard configurations & keys
data/wireguard_configs/*.conf
!data/wireguard_configs/.gitkeep

# Operating system artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Environment and secrets (Strict policy: never commit secrets)
.env
.env.*
!.env.example
.env.local

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
