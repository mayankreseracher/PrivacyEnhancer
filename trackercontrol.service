[Unit]
Description=TrackerControl PC — Sovereign Desktop Privacy Guard & WireGuard/Orbot Manager
Documentation=https://github.com/TrackerControl
After=network.target network-online.target systemd-resolved.service

[Service]
Type=simple
User=root
WorkingDirectory=%h/trackercontrol-pc
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
